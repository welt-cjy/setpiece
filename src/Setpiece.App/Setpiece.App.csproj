<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Setpiece.App</AssemblyName>
    <RootNamespace>Setpiece.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Setpiece</Product>
    <AssemblyTitle>Setpiece</AssemblyTitle>
    <Description>Project-scoped window scenes for Windows</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 用 manifest 配置 PerMonitorV2；WinForms 只用于托盘图标 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Setpiece.Core\Setpiece.Core.csproj" />
  </ItemGroup>

</Project>
