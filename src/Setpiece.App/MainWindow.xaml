<Window x:Class="Setpiece.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setpiece"
        Height="780" Width="1040"
        MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1F" Foreground="#E8E8EA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34343A" />
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45454C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D6CDF" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D6CDF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#26262B" />
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A3A42" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#26262B" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A3A42" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F7F7F8" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9A9AA3" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="项目" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9A9AA3" />
            <TextBox x:Name="ProjectBox" Grid.Column="1" IsReadOnly="True"
                     Padding="8,6" VerticalContentAlignment="Center" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="选择项目…" Margin="8,0" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#232329" CornerRadius="6">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="场景" FontWeight="SemiBold"
                               Foreground="#9A9AA3" Margin="4,2,4,8" />
                    <ListBox x:Name="SceneList" Background="Transparent" BorderThickness="0"
                             Foreground="#E8E8EA" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#232329" CornerRadius="6">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="SceneTitle" Text="选择一个场景" FontSize="17"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="EditToggle" Content="编辑场景" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel x:Name="RunPanel" Grid.Row="1">
                        <TextBlock x:Name="SceneMeta" Foreground="#9A9AA3" Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ApplyButton" Content="打开场景" Style="{StaticResource Primary}" />
                            <Button x:Name="CaptureButton" Content="保存当前位置" />
                            <Button x:Name="CloseButton" Content="关闭场景窗口" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="EditPanel" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="场景名" Style="{StaticResource Label}" />
                            <TextBox x:Name="EditName" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="布局模板" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="EditTemplate" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="显示器" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="EditMonitor" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="文件" Style="{StaticResource Label}" />
                            <ListBox x:Name="EditItems" Height="120" Background="#1F1F24"
                                     BorderThickness="1" BorderBrush="#3A3A42"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AddFileButton" Content="添加文件…" />
                                <Button x:Name="RemoveItemButton" Content="移除" />
                                <Button x:Name="MoveUpButton" Content="上移" />
                                <Button x:Name="MoveDownButton" Content="下移" />
                            </StackPanel>

                            <TextBlock Text="所选文件的打开方式" Style="{StaticResource Label}" />
                            <ComboBox x:Name="EditAdapter" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="SaveEditButton" Content="保存"
                                        Style="{StaticResource Primary}" />
                                <Button x:Name="CancelEditButton" Content="取消" />
                                <Button x:Name="ResetLayoutButton" Content="重置布局" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             Background="#1B1B1F" Foreground="#C8C8CF" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12" Padding="10"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0" Foreground="#9A9AA3" />
    </Grid>
</Window>
