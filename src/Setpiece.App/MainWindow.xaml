<Window x:Class="Setpiece.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setpiece"
        Icon="app.ico"
        Height="780" Width="1040"
        MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1F" Foreground="#E8E8EA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34343A" />
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45454C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D6CDF" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#2A2A31" />
            <Setter Property="Foreground" Value="#2D6CDF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最近项目列表里的一行：整行可点、左对齐、悬停高亮 -->
        <Style x:Key="RecentItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#31313A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶级菜单项：深色标题；弹出层用系统默认模板（浅色、深色文字） -->
        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 下拉菜单项：浅色弹层上的深色文字 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D6CDF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#26262B" />
            <Setter Property="Foreground" Value="#E8E8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A3A42" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#26262B" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A3A42" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F7F7F8" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9A9AA3" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="Transparent" Margin="-6,0,0,6">
            <MenuItem Header="文件(_F)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="打开项目…" InputGestureText="Ctrl+O"
                          Click="MenuOpenProject_Click" />
                <MenuItem Header="最近打开" x:Name="MenuRecent" />
                <MenuItem Header="新建工作区…" Click="MenuNewWorkspace_Click" />
                <MenuItem Header="新建场景…" InputGestureText="Ctrl+N"
                          Click="MenuNewScene_Click" />
                <Separator />
                <MenuItem Header="退出" InputGestureText="Alt+F4" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="场景(_S)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="打开场景" InputGestureText="F5" Click="MenuApplyScene_Click" />
                <MenuItem Header="保存当前位置" InputGestureText="Ctrl+S"
                          Click="MenuCapture_Click" />
                <MenuItem Header="关闭场景窗口" Click="MenuCloseScene_Click" />
                <Separator />
                <MenuItem Header="编辑场景" InputGestureText="Ctrl+E"
                          Click="MenuEditScene_Click" />
                <MenuItem Header="从当前窗口生成…" Click="MenuCaptureWindows_Click" />
                <MenuItem Header="删除场景" Click="MenuDeleteScene_Click" />
            </MenuItem>
            <MenuItem Header="工具(_T)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="打开项目文件夹" Click="MenuOpenProjectFolder_Click" />
                <MenuItem Header="打开配置文件夹" Click="MenuOpenConfigFolder_Click" />
                <Separator />
                <MenuItem x:Name="MenuCloseToTray" Header="关闭窗口时最小化到托盘"
                          IsCheckable="True" Click="MenuCloseToTray_Click" />
                <MenuItem Header="环境检查" Click="MenuEnvironmentCheck_Click" />
            </MenuItem>
            <MenuItem Header="帮助(_H)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="使用说明" Click="MenuReadme_Click" />
                <MenuItem Header="GitHub 项目主页" Click="MenuGitHub_Click" />
                <Separator />
                <MenuItem Header="关于 Setpiece" Click="MenuAbout_Click" />
            </MenuItem>
        </Menu>

        <Grid x:Name="ProjectBar" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="项目" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9A9AA3" />
            <TextBox x:Name="ProjectBox" Grid.Column="1" IsReadOnly="True"
                     Padding="8,6" VerticalContentAlignment="Center" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="选择项目…" Margin="8,0" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" />
            <Button x:Name="NewWorkspaceButton" Grid.Column="4" Content="新建工作区"
                    Margin="8,0,0,0" />
        </Grid>

        <Grid x:Name="MainContent" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#232329" CornerRadius="6">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock x:Name="SceneHeader" Text="场景" FontWeight="SemiBold"
                                   Foreground="#9A9AA3" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="NewSceneButton" Content="新建" Padding="7,2"
                                    Margin="0,0,4,0" FontSize="12" />
                            <Button x:Name="CaptureWindowsButton" Content="从窗口" Padding="7,2"
                                    Margin="0,0,4,0" FontSize="12" />
                            <Button x:Name="DeleteSceneButton" Content="删除" Padding="7,2"
                                    Margin="0" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="SceneList" Background="Transparent" BorderThickness="0"
                             Foreground="#E8E8EA" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#232329" CornerRadius="6">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="SceneTitle" Text="选择一个场景" FontSize="17"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="EditToggle" Content="编辑场景" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel x:Name="RunPanel" Grid.Row="1">
                        <TextBlock x:Name="SceneMeta" Foreground="#9A9AA3" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ApplyButton" Content="打开场景" Style="{StaticResource Primary}" />
                            <Button x:Name="CaptureButton" Content="保存当前位置" />
                            <Button x:Name="CloseButton" Content="关闭场景窗口" />
                        </StackPanel>

                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="1" Value="0" />
                            <TextBlock x:Name="ProgressText" Foreground="#9A9AA3" FontSize="12"
                                       Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="SceneFilesPanel" Grid.Row="2" Margin="0,12,0,10" Background="#1F1F24"
                            BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#2A2A31" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="350" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文件" Foreground="#9A9AA3"
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="1" Text="打开方式" Foreground="#9A9AA3"
                                           FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="显示器" Foreground="#9A9AA3"
                                           FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="自动打开" Foreground="#9A9AA3"
                                           FontSize="12" VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SceneFiles" Margin="0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Background="Transparent"
                                                    Padding="10,5" CornerRadius="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="340" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding File}"
                                                               Foreground="#E8E8EA"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding File}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Adapter}"
                                                               Foreground="#B9B9C2" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Monitor}"
                                                               Foreground="#B9B9C2" />
                                                    <TextBlock Grid.Column="3" Text="{Binding AutoOpen}"
                                                               Foreground="#B9B9C2" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="#2A2A31" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid x:Name="EditPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="场景名" Style="{StaticResource Label}" />
                            <TextBox x:Name="EditName" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="布局模板" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="EditTemplate" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="显示器" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="EditMonitor" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="文件" Style="{StaticResource Label}" />
                            <ListBox x:Name="EditItems" Height="100" Background="#1F1F24"
                                     BorderThickness="1" BorderBrush="#3A3A42"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AddFileButton" Content="添加文件…" />
                                <Button x:Name="RemoveItemButton" Content="移除" />
                                <Button x:Name="MoveUpButton" Content="上移" />
                                <Button x:Name="MoveDownButton" Content="下移" />
                            </StackPanel>

                            <TextBlock Text="所选文件的打开方式" Style="{StaticResource Label}" />
                            <ComboBox x:Name="EditAdapter" />

                            <TextBlock Text="所选文件的显示器" Style="{StaticResource Label}" />
                            <ComboBox x:Name="EditItemMonitor" />

                            <CheckBox x:Name="EditAutoOpen" Content="打开场景时自动启动"
                                      Foreground="#E8E8EA" Margin="0,12,0,0" />
                        </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SaveEditButton" Content="保存"
                                    Style="{StaticResource Primary}" />
                            <Button x:Name="CancelEditButton" Content="取消" />
                            <Button x:Name="ResetLayoutButton" Content="重置布局" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                             Background="#1B1B1F" Foreground="#C8C8CF" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12" Padding="10"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="WelcomePanel" Grid.Row="2" Background="#1B1B1F" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="540">
                <Image Source="app-logo.png" Width="76" Height="76" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Setpiece" FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,6" />
                <TextBlock Text="按项目保存工作现场：文件、窗口位置和显示器布局，一键恢复"
                           Foreground="#9A9AA3" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="打开项目…" Style="{StaticResource Primary}" Width="140"
                            Click="WelcomeOpen_Click" />
                    <Button Content="新建工作区…" Width="140" Margin="8,0,0,0"
                            Click="WelcomeNew_Click" />
                </StackPanel>

                <TextBlock Text="最近打开" Foreground="#9A9AA3" FontSize="12" Margin="2,28,0,6" />
                <Border Background="#232329" CornerRadius="6" Padding="6" MinHeight="52">
                    <StackPanel x:Name="RecentList" />
                </Border>

                <TextBlock Text="Ctrl+Alt+W 唤起窗口 · Ctrl+Alt+1~9 打开场景"
                           Foreground="#6F6F79" FontSize="11" HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,10,0,0" Foreground="#9A9AA3" />
    </Grid>
</Window>
